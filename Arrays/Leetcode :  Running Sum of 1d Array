class Solution {
    public int[] runningSum(int[] nums) {
        int[] nums1 = new int[nums.length];

        nums1[0]=nums[0];
        for(int i=1; i<nums.length; i++){
            int prevSum = nums1[i-1];
            int currSum = nums[i];
            int sum = prevSum + currSum;
            nums1[i]=sum;
        }
        return nums1;
    }
}
